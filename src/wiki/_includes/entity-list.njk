<div class="filters" hidden data-filters><label>{{ ui.filter }}<input type="search" data-list-query placeholder="{{ ui.searchPlaceholder }}"></label><label data-type-label>{{ ui.fields.category }}<select data-type-filter><option value="">{{ ui.all }}</option></select></label>{% for facet in ['rarity', 'slot', 'skill', 'source'] %}<label hidden data-facet-label>{{ ui[facet] }}<select data-facet="{{ facet }}"><option value="">{{ ui.all }}</option></select></label>{% endfor %}<label data-level-label>{{ ui.level }} ≥<input data-min-level type="number" min="0" value="0"></label><label>{{ ui.sort }}<select data-sort><option value="default">{{ ui.terms.defaultOrder }}</option><option value="name">{{ ui.name }}</option><option value="level">{{ ui.level }}</option></select></label><button class="button" type="button" data-reset-filters>{{ ui.clear }}</button><output id="list-count" data-list-count data-range="{{ ui.terms.showingRange }}" data-all="{{ ui.all }}" aria-live="polite"></output>{% if entry.listIndexUrl %}<small>{{ ui.terms.filterScope }}</small>{% endif %}</div>
{% include 'client-pager.njk' %}
<p class="data-section" data-list-empty hidden>{{ ui.noResults }} <button class="button" type="button" data-reset-filters>{{ ui.clear }}</button></p>
<ul class="entity-list" tabindex="-1" aria-describedby="list-count" data-base-url="{{ entry.pageUrls[0] }}" data-entity-list data-page="{{ entry.pageNumber or 1 }}"{% if entry.listIndexUrl %} data-list-index="{{ entry.listIndexUrl }}"{% endif %}>{% for listed in listedEntities %}{% set row = listed | listRecord(lang) %}<li data-name="{{ row.search }}" data-type="{{ row.type }}" data-level="{{ row.level }}" data-facets="{{ row.facets | dump }}"><a href="{{ row.url }}"><img src="{{ row.image }}" alt="" loading="lazy" width="32" height="32"><span><strong>{{ row.name }}</strong>{% if row.level %}<small>{{ ui.level }} {{ row.level }}</small>{% endif %}{% if row.summary %}<small>{{ row.summary }}</small>{% endif %}</span><span class="row-type">{{ row.type }}</span><span aria-hidden="true">↗</span></a></li>{% endfor %}</ul>
{% if entry.pageUrls.length > 1 %}<nav class="pagination" data-pagination aria-label="{{ ui.terms.page }}">{% for url in entry.pageUrls %}<a href="{{ url }}"{% if loop.index == entry.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>{% endfor %}</nav>{% endif %}
{% include 'client-pager.njk' %}
