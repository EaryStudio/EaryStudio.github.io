{
  "name": "eary-studio-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/wiki/build.mjs",
    "preview": "node scripts/wiki/build.mjs --serve",
    "wiki:import": "node scripts/wiki/import.mjs",
    "wiki:validate": "node scripts/wiki/validate.mjs",
    "test": "node --test tests/*.test.cjs tests/wiki/*.test.mjs",
    "verify": "npm run wiki:validate && npm test && npm run build && node scripts/wiki/check-site.mjs"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "ajv": "8.20.0",
    "markdown-it": "14.3.2",
    "sharp": "0.35.5"
  }
}
